@model IEnumerable<web_backup.Models.Room>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-teal m-0" style="color: #0d7a75;">@ViewData["Heading"]</h3>
        <span class="text-muted">Hiển thị @Model.Count() kết quả</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted display-4"></i>
            <p class="text-muted mt-3">Hiện chưa có bài đăng nào thuộc danh mục này.</p>
            <a href="/" class="btn btn-outline-teal rounded-pill px-4">Xem tất cả phòng</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var room in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative card-hover">
                        <img src="@room.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@room.Title" />
                        <div class="card-body">
                            <span class="badge bg-teal mb-2" style="background-color: #0d7a75;">@(room.Category?.Name ?? "Chung")</span>
                            <h5 class="card-title text-truncate fw-bold">
                                <!-- THÊM LINK TẠI ĐÂY -->
                                <a href="/Home/Details/@room.Id" class="text-decoration-none text-dark stretched-link">
                                    @room.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@room.District - @room.Address</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-danger fw-bold fs-5">@room.Price.ToString("N0") VNĐ/tháng</span>
                                <span class="text-muted small">@room.Area m²</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>