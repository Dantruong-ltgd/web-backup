@model web_backup.Models.Room
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Hình ảnh phòng -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <img src="@Model.ImageUrl" class="w-100" style="max-height: 450px; object-fit: cover;" alt="@Model.Title" />
            </div>
        </div>

        <!-- Thông tin chi tiết phòng -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <span class="badge bg-teal w-auto mb-2 align-self-start px-3 py-2" style="background-color: #0d7a75;">
                    @(Model.Category?.Name ?? "Phòng trọ")
                </span>
                <h3 class="fw-bold text-dark mb-3">@Model.Title</h3>

                <h2 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") <small class="fs-6 text-muted">VNĐ/tháng</small></h2>

                <div class="list-group list-group-flush mb-4">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2 text-danger"></i>Địa chỉ:</span>
                        <strong class="text-end">@Model.Address, @Model.District</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-arrows-angle-expand me-2 text-primary"></i>Diện tích:</span>
                        <strong>@Model.Area m²</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-check-circle me-2 text-success"></i>Chính chủ:</span>
                        <strong>@(Model.IsOwner ? "Có" : "Không")</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-house-door me-2 text-info"></i>Có gác lửng:</span>
                        <strong>@(Model.HasMezzanine ? "Có" : "Không")</strong>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a href="tel:0901234567" class="btn btn-teal text-white py-3 rounded-pill fw-bold" style="background-color: #0d7a75;">
                        <i class="bi bi-telephone-fill me-2"></i>Liên hệ chủ phòng ngay
                    </a>
                    <a href="/" class="btn btn-outline-secondary py-2 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>