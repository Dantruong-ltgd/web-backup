@model web_backup.Models.Room
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row g-4">
        <!-- Hình ảnh phòng -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <img src="@Model.ImageUrl" class="w-100" style="max-height: 450px; object-fit: cover;" alt="@Model.Title" />
            </div>
        </div>

        <!-- Thông tin chi tiết phòng -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-teal w-auto px-3 py-2" style="background-color: #0d7a75;">
                        @(Model.Category?.Name ?? "Phòng trọ")
                    </span>

                    <!-- Nút Thả tim góc trên -->
                    <button type="button" id="btnHeartIcon" class="btn btn-outline-danger rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm"
                            style="width: 40px; height: 40px;"
                            onclick="toggleFavoriteDetail(@Model.Id)" title="Thả tim phòng này">
                        <i id="heartIcon" class="bi @(Model.IsFeatured ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-5"></i>
                    </button>
                </div>

                <h3 class="fw-bold text-dark mb-3">@Model.Title</h3>

                <h2 class="text-danger fw-bold mb-4">@Model.Price.ToString("N0") <small class="fs-6 text-muted">VNĐ/tháng</small></h2>

                <div class="list-group list-group-flush mb-4">
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2 text-danger"></i>Địa chỉ:</span>
                        <strong class="text-end">@Model.Address, @Model.District</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-arrows-angle-expand me-2 text-primary"></i>Diện tích:</span>
                        <strong>@Model.Area m²</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-check-circle me-2 text-success"></i>Chính chủ:</span>
                        <strong>@(Model.IsOwner ? "Có" : "Không")</strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0 py-2">
                        <span class="text-muted"><i class="bi bi-house-door me-2 text-info"></i>Có gác lửng:</span>
                        <strong>@(Model.HasMezzanine ? "Có" : "Không")</strong>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <!-- Nút Thêm/Bỏ Yêu thích (Hiện lên Trang chủ) -->
                    <button type="button" id="btnFavoriteText" onclick="toggleFavoriteDetail(@Model.Id)"
                            class="btn @(Model.IsFeatured ? "btn-danger" : "btn-outline-danger") py-2.5 rounded-pill fw-bold shadow-sm">
                        <i id="btnFavoriteIcon" class="bi @(Model.IsFeatured ? "bi-heart-fill" : "bi-heart") me-2"></i>
                        <span id="favoriteText">@(Model.IsFeatured ? "Đã yêu thích (Đang hiện ở Trang chủ)" : "Thêm vào Yêu thích (Hiện ở Trang chủ)")</span>
                    </button>

                    <!-- NÚT ĐẶT CỌC NGAY (Đã cập nhật chuyển hướng đến trang Đặt cọc) -->
                    <a asp-controller="Payment" asp-action="Checkout" asp-route-roomId="@Model.Id" asp-route-type="Deposit"
                       class="btn btn-teal text-white py-3 rounded-pill fw-bold shadow-sm text-center" style="background-color: #0d7a75;">
                        <i class="bi bi-bookmark-check-fill me-2"></i>Đặt cọc ngay
                    </a>

                    <a href="/" class="btn btn-outline-secondary py-2 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT XỬ LÝ THẢ TIM AJAX -->
@section Scripts {
    <script>
        function toggleFavoriteDetail(roomId) {
            $.post('/Home/ToggleFavorite', { id: roomId }, function(res) {
                if (res.success) {
                    var isFav = res.isFeatured;
                    if (isFav) {
                        $('#heartIcon').removeClass('bi-heart text-secondary').addClass('bi-heart-fill text-danger');
                        $('#btnFavoriteText').removeClass('btn-outline-danger').addClass('btn-danger');
                        $('#btnFavoriteIcon').removeClass('bi-heart').addClass('bi-heart-fill');
                        $('#favoriteText').text('Đã yêu thích (Đang hiện ở Trang chủ)');
                    } else {
                        $('#heartIcon').removeClass('bi-heart-fill text-danger').addClass('bi-heart text-secondary');
                        $('#btnFavoriteText').removeClass('btn-danger').addClass('btn-outline-danger');
                        $('#btnFavoriteIcon').removeClass('bi-heart-fill').addClass('bi-heart');
                        $('#favoriteText').text('Thêm vào Yêu thích (Hiện ở Trang chủ)');
                    }
                } else {
                    alert(res.message || 'Có lỗi xảy ra, vui lòng thử lại!');
                }
            });
        }
    </script>
}