@model IEnumerable<web_backup.Models.Room>
@{
    ViewData["Title"] = "Trang chủ - PT-SG";

    // 1. Danh sách phòng do Chủ trọ VIP đăng (User.IsVip == true)
    var vipLandlordRooms = Model?.Where(r => r.User != null && r.User.IsVip).ToList() ?? new List<web_backup.Models.Room>();

    // 2. Danh sách phòng trọ nổi bật (Bài đăng VIP - IsFeatured == true)
    var featuredRooms = Model?.Where(r => r.IsFeatured && (r.User == null || !r.User.IsVip)).ToList() ?? new List<web_backup.Models.Room>();
}

<!-- THÔNG BÁO XÁC NHẬN THANH TOÁN THÀNH CÔNG -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
            <div>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<!-- BANNER & KHU VỰC TÌM KIẾM -->
<div class="hero-section text-white py-5 position-relative" style="background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat; min-height: 380px;">
    <div class="container py-4">
        <div class="text-center mb-4">
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold text-uppercase mb-2" style="letter-spacing: 1px;">HANOI / HCMC SKYLINE</span>
            <h1 class="fw-extrabold display-5 text-white mb-2" style="font-weight: 800; text-shadow: 0 2px 4px rgba(0,0,0,0.4);">
                TÌM PHÒNG TRỌ, CHUNG CƯ HCMC<br />ĐƠN GIẢN & NHANH CHÓNG!
            </h1>
        </div>

        <!-- FORM TÌM KIẾM -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <form action="/Home/Search" method="get" class="bg-white p-3 p-md-4 rounded-4 shadow-lg text-dark">
                    <div class="row g-3 align-items-center">

                        <!-- 1. Từ khóa / Khu vực -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-teal small mb-1">
                                <i class="bi bi-geo-alt-fill me-1"></i> Từ khóa / Khu vực
                            </label>
                            <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" class="form-control bg-light border-0 py-2 shadow-none" placeholder="Quận, huyện, hoặc tên đường..." />
                        </div>

                        <!-- 2. Loại hình phòng -->
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-teal small mb-1">
                                <i class="bi bi-house-door-fill me-1"></i> Loại hình
                            </label>
                            <select name="categoryId" class="form-select bg-light border-0 py-2 shadow-none">
                                <option value="">-- Tất cả loại phòng --</option>
                                @{
                                    var currentCategory = Context.Request.Query["categoryId"].ToString();
                                }

                                <option value="nha-nguyen-can" selected="@(currentCategory == "nha-nguyen-can" ? "selected" : null)">Nhà nguyên căn</option>
                                <option value="o-ghep" selected="@(currentCategory == "o-ghep" ? "selected" : null)">Ở ghép</option>

                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in (IEnumerable<web_backup.Models.Category>)ViewBag.Categories)
                                    {
                                        var isSelected = currentCategory == cat.Id.ToString() ? "selected" : null;
                                        <option value="@cat.Id" selected="@isSelected">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- 3. Mức giá tối đa -->
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-teal small mb-1">
                                <i class="bi bi-cash-stack me-1"></i> Mức giá tối đa
                            </label>
                            @{
                                var selectedPrice = Context.Request.Query["maxPrice"].ToString();
                            }
                            <select name="maxPrice" class="form-select bg-light border-0 py-2 shadow-none">
                                <option value="" selected="@(string.IsNullOrEmpty(selectedPrice) ? "selected" : null)">-- Chọn mức giá --</option>
                                <option value="0-2000000" selected="@(selectedPrice == "0-2000000" ? "selected" : null)">Dưới 2 triệu</option>
                                <option value="2000000-4000000" selected="@(selectedPrice == "2000000-4000000" ? "selected" : null)">2 - 4 triệu</option>
                                <option value="4000000-7000000" selected="@(selectedPrice == "4000000-7000000" ? "selected" : null)">4 - 7 triệu</option>
                                <option value="7000000-20000000" selected="@(selectedPrice == "7000000-20000000" ? "selected" : null)">Trên 7 triệu</option>
                            </select>
                        </div>

                        <!-- 4. Nút Tìm kiếm -->
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-teal w-100 py-2 rounded-3 text-white fw-bold shadow-sm">
                                <i class="bi bi-search me-1"></i> Tìm kiếm
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">

    <!-- ================= Khung 1: KHUNG PHÒNG TỪ CHỦ TRỌ VIP ================= -->
    <div class="mb-5 p-4 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #f3e8ff 0%, #ffffff 100%); border: 2px solid #a855f7;">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h3 class="fw-bold m-0" style="color: #6b21a8;">
                <i class="bi bi-gem text-warning me-2"></i>PHÒNG TRỌ TỪ CHỦ TRỌ VIP
            </h3>
            <span class="badge text-white px-3 py-2 rounded-pill fw-bold" style="background-color: #a855f7;">
                <i class="bi bi-shield-check me-1"></i>@vipLandlordRooms.Count Phòng Uy Tín
            </span>
        </div>

        @if (!vipLandlordRooms.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                Chưa có phòng trọ nào từ các Chủ trọ gói VIP.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var room in vipLandlordRooms)
                {
                    bool isBuyoutSupported = room.IsForSale && room.Category != null &&
                        (room.Category.Name.Contains("Chung cư") || room.Category.Name.Contains("Nhà nguyên căn"));

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative card-hover bg-white">
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800" : room.ImageUrl)"
                                     class="w-100 h-100" style="object-fit: cover; transition: transform 0.3s ease;" alt="@room.Title" />

                                <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill bg-teal text-white shadow-sm">
                                    @(room.Category?.Name ?? "Phòng trọ")
                                </span>

                                <button type="button" class="btn btn-favorite position-absolute top-0 end-0 m-3 shadow-sm" title="Yêu thích">
                                    <i class="bi bi-heart-fill"></i>
                                </button>

                                @if (room.IsOwner)
                                {
                                    <span class="badge position-absolute top-0 start-0 m-3 mt-5 px-2 py-1 rounded-pill bg-warning text-dark shadow-sm fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Chính chủ
                                    </span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@room.Title">
                                    <a href="/Home/Details/@room.Id" class="text-decoration-none text-dark stretched-link">
                                        @room.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted small mb-3 text-truncate">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@room.District - @room.Address
                                </p>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="text-danger fw-bold fs-5">@room.Price.ToString("N0")</span>
                                        <span class="text-muted small"> VNĐ/tháng</span>
                                    </div>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-arrows-angle-expand me-1"></i>@room.Area m²
                                    </span>
                                </div>

                                <div class="mt-auto pt-3 border-top d-grid gap-2" style="position: relative; z-index: 2;">
                                    @if (isBuyoutSupported && room.SalePrice.HasValue)
                                    {
                                        <a asp-controller="Payment" asp-action="Checkout" asp-route-roomId="@room.Id" asp-route-type="Buyout"
                                           class="btn btn-outline-danger btn-sm rounded-pill fw-bold py-2">
                                            <i class="bi bi-bag-check-fill me-1"></i>Mua đứt (@room.SalePrice.Value.ToString("N0") VNĐ)
                                        </a>
                                    }
                                    <a asp-controller="Payment" asp-action="Checkout" asp-route-roomId="@room.Id" asp-route-type="Deposit"
                                       class="btn btn-teal text-white btn-sm rounded-pill fw-bold py-2">
                                        <i class="bi bi-bookmark-check me-1"></i>Đặt chỗ (Cọc 20%)
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ================= Khung 2: DANH SÁCH PHÒNG TRỌ NỔI BẬT ================= -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h3 class="fw-bold text-dark m-0">
                <i class="bi bi-star-fill text-warning me-2"></i>PHÒNG TRỌ NỔI BẬT
            </h3>
        </div>

        @if (!featuredRooms.Any())
        {
            <div class="text-center py-4 text-muted bg-light rounded-4 border">
                <h6 class="mb-0">Hiện chưa có bài đăng nổi bật nào khác.</h6>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var room in featuredRooms)
                {
                    bool isBuyoutSupported = room.IsForSale && room.Category != null &&
                        (room.Category.Name.Contains("Chung cư") || room.Category.Name.Contains("Nhà nguyên căn"));

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative card-hover bg-white">
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img src="@(string.IsNullOrEmpty(room.ImageUrl) ? "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800" : room.ImageUrl)"
                                     class="w-100 h-100" style="object-fit: cover; transition: transform 0.3s ease;" alt="@room.Title" />

                                <span class="badge position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill bg-teal text-white shadow-sm">
                                    @(room.Category?.Name ?? "Phòng trọ")
                                </span>

                                <button type="button" class="btn btn-favorite position-absolute top-0 end-0 m-3 shadow-sm" title="Yêu thích">
                                    <i class="bi bi-heart-fill"></i>
                                </button>

                                @if (room.IsOwner)
                                {
                                    <span class="badge position-absolute top-0 start-0 m-3 mt-5 px-2 py-1 rounded-pill bg-warning text-dark shadow-sm fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Chính chủ
                                    </span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@room.Title">
                                    <a href="/Home/Details/@room.Id" class="text-decoration-none text-dark stretched-link">
                                        @room.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted small mb-3 text-truncate">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@room.District - @room.Address
                                </p>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="text-danger fw-bold fs-5">@room.Price.ToString("N0")</span>
                                        <span class="text-muted small"> VNĐ/tháng</span>
                                    </div>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-arrows-angle-expand me-1"></i>@room.Area m²
                                    </span>
                                </div>

                                <div class="mt-auto pt-3 border-top d-grid gap-2" style="position: relative; z-index: 2;">
                                    @if (isBuyoutSupported && room.SalePrice.HasValue)
                                    {
                                        <a asp-controller="Payment" asp-action="Checkout" asp-route-roomId="@room.Id" asp-route-type="Buyout"
                                           class="btn btn-outline-danger btn-sm rounded-pill fw-bold py-2">
                                            <i class="bi bi-bag-check-fill me-1"></i>Mua đứt (@room.SalePrice.Value.ToString("N0") VNĐ)
                                        </a>
                                    }
                                    <a asp-controller="Payment" asp-action="Checkout" asp-route-roomId="@room.Id" asp-route-type="Deposit"
                                       class="btn btn-teal text-white btn-sm rounded-pill fw-bold py-2">
                                        <i class="bi bi-bookmark-check me-1"></i>Đặt chỗ (Cọc 20%)
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- CSS TÙY CHỈNH -->
<style>
    .text-teal {
        color: #7c3aed !important;
    }

    .btn-teal {
        background-color: #7c3aed !important;
        border-color: #7c3aed !important;
    }

        .btn-teal:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

    .btn-favorite {
        width: 38px;
        height: 38px;
        border-radius: 50% !important;
        background-color: #ffffff !important;
        border: 1.5px solid #ef4444 !important;
        color: #ef4444 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        z-index: 3;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

        .btn-favorite:hover {
            transform: scale(1.1);
            background-color: #fef2f2 !important;
        }

    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
        }

            .card-hover:hover img {
                transform: scale(1.05);
            }
</style>