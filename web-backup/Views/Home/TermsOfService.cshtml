@{
    ViewData["Title"] = "Điều Khoản Sử Dụng";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase" style="color: var(--main-purple);">Điều Khoản Sử Dụng</h2>
        <p class="text-muted">Các quy định chung khi trải nghiệm dịch vụ trên PT-SG</p>
    </div>

    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 mx-auto" style="max-width: 900px;">
        <h5 class="fw-bold text-dark mb-3">1. Chấp nhận điều khoản</h5>
        <p class="text-muted mb-4">
            Khi truy cập và sử dụng website PT-SG, bạn đồng ý tuân thủ toàn bộ các điều khoản được quy định tại đây. Nếu không đồng ý, vui lòng ngừng sử dụng dịch vụ.
        </p>

        <h5 class="fw-bold text-dark mb-3">2. Báo mật tài khoản</h5>
        <p class="text-muted mb-4">
            Người dùng có trách nhiệm tự bảo mật mật khẩu và thông tin đăng nhập của mình. PT-SG không chịu trách nhiệm đối với các tổn thất phát sinh do bạn tiết lộ thông tin tài khoản cho bên thứ ba.
        </p>

        <h5 class="fw-bold text-dark mb-3">3. Tuyên bố miễn trừ trách nhiệm</h5>
        <p class="text-muted mb-0">
            PT-SG là nền tảng kết nối giữa Chủ nhà và Người thuê. Chúng tôi nỗ lực kiểm duyệt thông tin nhưng không trực tiếp tham gia vào quá trình ký kết hợp đồng đặt cọc/thuê nhà ngoài thực tế giữa hai bên.
        </p>
    </div>
</div>