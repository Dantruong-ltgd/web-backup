@model web_backup.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Cập nhật thông tin cá nhân";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold text-center text-teal mb-4"><i class="bi bi-pencil-square me-2"></i>CẬP NHẬT THÔNG TIN CÁ NHÂN</h4>

                <!-- LƯU Ý: Đã thêm enctype="multipart/form-data" để gửi file ảnh -->
                <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- ================= CỤM THAY ĐỔI ẢNH ĐẠI DIỆN ================= -->
                    <div class="text-center mb-4">
                        <div class="position-relative d-inline-block">
                            <!-- Ảnh xem trước -->
                            <img id="avatarPreview"
                                 src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                                 alt="Avatar Preview"
                                 class="rounded-circle object-fit-cover border shadow-sm"
                                 style="width: 110px; height: 110px;" />

                            <!-- Nút icon máy ảnh đè lên góc ảnh -->
                            <label for="AvatarFile"
                                   class="btn btn-sm text-white rounded-circle position-absolute bottom-0 end-0 p-2 shadow-sm"
                                   style="background-color: #0d7a75; cursor: pointer;"
                                   title="Đổi ảnh đại diện">
                                <i class="bi bi-camera-fill fs-6"></i>
                            </label>

                            <!-- Input chọn file (Ẩn) -->
                            <input type="file" id="AvatarFile" name="AvatarFile" accept="image/*" class="d-none" onchange="previewImage(event)" />
                        </div>
                        <div class="form-text small text-muted mt-2">Nhấp vào biểu tượng máy ảnh để tải ảnh mới</div>
                    </div>
                    <!-- ============================================================= -->

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control rounded-3" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="0901234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    @if (User.IsInRole("ChuTro"))
                    {
                        <div class="mb-3">
                            <label asp-for="District" class="form-label fw-semibold">Quận/Huyện quản lý</label>
                            <select asp-for="District" class="form-select rounded-3">
                                <option value="">-- Chọn Quận --</option>
                                <option value="Quận 1">Quận 1</option>
                                <option value="Bình Thạnh">Bình Thạnh</option>
                                <option value="Quận 10">Quận 10</option>
                                <option value="Gò Vấp">Gò Vấp</option>
                                <option value="Thủ Đức">Thủ Đức</option>
                            </select>
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-teal text-white rounded-pill px-4 fw-bold" style="background-color: #0d7a75;">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JS Xem trước ảnh ngay lập tức khi người dùng chọn file -->
@section Scripts {
    <script>
        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}