@{
    ViewData["Title"] = "Thanh Toán VIP Qua QR Code";
}

<div class="container my-5 text-center" style="max-width: 500px;">
    <div class="card border-0 shadow-lg rounded-4 p-4">
        <h4 class="fw-bold text-primary mb-2">QUÉT MÃ QR THANH TOÁN</h4>
        <p class="text-muted small">Dùng ứng dụng Ngân hàng để quét mã nâng cấp 7 ngày VIP</p>

        <div class="my-3 p-2 bg-light rounded-3 d-inline-block">
            <img src="@ViewBag.QrUrl" alt="Mã QR Thanh Toán" class="img-fluid rounded-3 shadow-sm" style="max-width: 280px;" />
        </div>

        <div class="text-start bg-light p-3 rounded-3 mb-3 fs-6">
            <p class="mb-1">Mã hóa đơn: <strong class="text-primary">@ViewBag.InvoiceCode</strong></p>
            <p class="mb-0">Số tiền: <strong class="text-danger">@ViewBag.Amount.ToString("N0") VNĐ</strong></p>
        </div>

        <div class="alert alert-info small mb-3">
            <i class="bi bi-info-circle me-1"></i> Sau khi chuyển khoản thành công, hệ thống sẽ xác nhận và tự động kích hoạt **7 ngày VIP** cho tài khoản của bạn.
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary rounded-pill w-100">
            Trở về trang chủ
        </a>
    </div>
</div>