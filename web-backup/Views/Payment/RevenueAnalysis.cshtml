@model web_backup.Models.RevenueReportViewModel
@{
    ViewData["Title"] = "Bảng Phân Tích Doanh Thu";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
}

<div class="container-fluid my-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-graph-up-arrow me-2"></i>Bảng Phân Tích Doanh Thu</h2>
            <p class="text-muted mb-0">Thống kê chi tiết doanh thu thực nhận từ các giao dịch thành công</p>
        </div>
        <div>
            <!-- Bộ lọc chọn năm -->
            <form method="get" asp-action="RevenueAnalysis" class="d-flex align-items-center gap-2">
                <label class="fw-bold text-secondary">Năm:</label>
                <select name="year" class="form-select rounded-pill shadow-sm" onchange="this.form.submit()">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 4; y--)
                    {
                        <option value="@y" selected="@(y == selectedYear)">Năm @y</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- 1. THẺ THỐNG KÊ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="fs-6 opacity-75">TỔNG DOANH THU TOÀN BỘ</span>
                        <h3 class="fw-bold mt-2 mb-0">@Model.TotalRevenue.ToString("N0") VNĐ</h3>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 fs-2">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="fs-6 opacity-75">DOANH THU THÁNG NÀY</span>
                        <h3 class="fw-bold mt-2 mb-0">@Model.CurrentMonthRevenue.ToString("N0") VNĐ</h3>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 fs-2">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-info text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="fs-6 opacity-75">GIAO DỊCH THÀNH CÔNG</span>
                        <h3 class="fw-bold mt-2 mb-0">@Model.TotalPaidInvoices Đơn</h3>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 fs-2">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BIỂU ĐỒ & BẢNG PHÂN TÍCH LOẠI HÌNH -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ doanh thu 12 tháng -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Doanh thu 12 tháng năm @selectedYear</h5>
                <div style="height: 320px;">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Bảng phân tích theo Loại hình danh mục -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Doanh thu theo Loại hình</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Danh mục</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CategoryRevenues.Any())
                            {
                                @foreach (var cat in Model.CategoryRevenues)
                                {
                                    <tr>
                                        <td class="fw-semibold">@cat.CategoryName</td>
                                        <td class="text-center"><span class="badge bg-secondary">@cat.Count</span></td>
                                        <td class="text-end text-danger fw-bold">@cat.Total.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="text-center text-muted">Chưa có dữ liệu</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. BẢNG CHI TIẾT DOANH THU 12 THÁNG & GIAO DỊCH GẦN ĐÂY -->
    <div class="row g-4">
        <!-- Bảng Doanh thu theo tháng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-table me-2 text-primary"></i>Chi tiết từng tháng (Năm @selectedYear)</h5>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Tháng</th>
                                <th class="text-center">Số lượng đơn</th>
                                <th class="text-end">Tổng tiền (VNĐ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MonthlyRevenues)
                            {
                                <tr>
                                    <td class="fw-bold">Tháng @item.Month</td>
                                    <td class="text-center">@item.Count</td>
                                    <td class="text-end fw-bold text-success">@item.Total.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Bảng Giao dịch gần đây -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>10 Giao dịch thành công mới nhất</h5>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã HD</th>
                                <th>Khách hàng</th>
                                <th>Ngày tạo</th>
                                <th class="text-end">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentInvoices.Any())
                            {
                                @foreach (var inv in Model.RecentInvoices)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary font-monospace">@inv.InvoiceCode</span></td>
                                        <td>@inv.CustomerName</td>
                                        <td>@inv.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end fw-bold text-danger">@inv.TotalAmount.ToString("N0") đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted">Chưa có giao dịch nào</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT VẼ BIỂU ĐỒ BẰNG CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = [@Html.Raw(string.Join(",", Model.MonthlyRevenues.Select(m => $"'T{m.Month}'")))];
    const dataValues = [@string.Join(",", Model.MonthlyRevenues.Select(m => m.Total))];

    const ctx = document.getElementById('monthlyChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: dataValues,
                backgroundColor: 'rgba(37, 99, 235, 0.7)',
                borderColor: 'rgba(37, 99, 235, 1)',
                borderWidth: 1,
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString('vi-VN') + ' đ';
                        }
                    }
                }
            }
        }
    });
</script>