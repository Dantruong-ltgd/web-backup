@model IEnumerable<web_backup.Models.Room>
@{
    ViewData["Title"] = "Quản lý phòng trọ";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0"><i class="bi bi-house-gear me-2"></i>DANH SÁCH QUẢN LÝ PHÒNG</h3>

        <div class="d-flex align-items-center gap-2">
            <!-- Nút Thêm phòng mới -->
            <a href="/RoomManager/Create" class="btn btn-teal text-white rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #0d7a75;">
                <i class="bi bi-plus-lg me-1"></i> Thêm phòng mới
            </a>
            <span class="badge bg-info text-dark px-3 py-2 fs-6">Tổng số: @Model.Count() phòng</span>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Hình ảnh</th>
                        <th>Tiêu đề phòng</th>
                        <th>Khu vực / Quận</th>
                        <th>Giá thuê</th>
                        <th>Diện tích</th>
                        <th>Loại phòng</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <!-- Gắn id vào dòng tr để phục vụ xóa tức thì bằng AJAX -->
                        <tr id="room-row-@item.Id">
                            <td>
                                <img src="@item.ImageUrl" class="rounded-3 shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" alt="@item.Title" />
                            </td>
                            <td>
                                <strong class="text-dark">@item.Title</strong>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.District</span></td>
                            <td class="text-success fw-bold">@item.Price.ToString("N0") VNĐ</td>
                            <td>@item.Area m²</td>
                            <td>@(item.Category?.Name ?? "N/A")</td>

                            <!-- CỘT TRẠNG THÁI -->
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input cursor-pointer" type="checkbox" id="status_@item.Id"
                                    @(item.IsRented ? "checked" : "") onchange="toggleRoomStatus(@item.Id, this)" />
                                    <label class="form-check-label small fw-bold @(item.IsRented ? "text-danger" : "text-success")" for="status_@item.Id" id="label_@item.Id">
                                        @(item.IsRented ? "Đã thuê/Mua" : "Còn trống")
                                    </label>
                                </div>
                            </td>

                            <!-- THAO TÁC: SỬA & XÓA -->
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                        <i class="bi bi-pencil-square me-1"></i> Sửa
                                    </a>
                                    <button onclick="deleteRoom(@item.Id)" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> Xóa
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // 1. Hàm Bật/Tắt trạng thái phòng
    async function toggleRoomStatus(roomId, checkbox) {
        const label = document.getElementById(`label_${roomId}`);
        const originalState = !checkbox.checked;

        try {
            const response = await fetch(`/RoomManager/ToggleStatus/${roomId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            if (response.ok) {
                if (checkbox.checked) {
                    label.textContent = "Đã thuê/Mua";
                    label.className = "form-check-label small fw-bold text-danger";
                } else {
                    label.textContent = "Còn trống";
                    label.className = "form-check-label small fw-bold text-success";
                }
            } else {
                alert("Không thể cập nhật trạng thái!");
                checkbox.checked = originalState;
            }
        } catch (error) {
            alert("Lỗi kết nối máy chủ!");
            checkbox.checked = originalState;
        }
    }

    // 2. Hàm Xóa phòng
    async function deleteRoom(roomId) {
        if (!confirm("Bạn có chắc chắn muốn xóa phòng này không? Hành động này không thể hoàn tác.")) {
            return;
        }

        try {
            const response = await fetch(`/RoomManager/Delete/${roomId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            if (response.ok) {
                // Xóa dòng tương ứng trên bảng HTML
                const row = document.getElementById(`room-row-${roomId}`);
                if (row) {
                    row.remove();
                }
                alert("Xóa phòng thành công!");
            } else {
                const resData = await response.json().catch(() => null);
                alert(resData?.message || "Không thể xóa phòng này!");
            }
        } catch (error) {
            alert("Lỗi kết nối máy chủ!");
        }
    }
</script>