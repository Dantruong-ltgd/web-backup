@model web_backup.Models.Room
@{
    ViewData["Title"] = "Thêm phòng mới";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold mb-4 text-teal" style="color: #0d7a75;"><i class="bi bi-plus-circle me-2"></i>THÊM PHÒNG TRỌ MỚI</h4>

                <form asp-action="Create" method="post">
                    <!-- Xem trước hình ảnh từ URL -->
                    <div class="mb-4 text-center bg-light p-3 rounded-3 border">
                        <label class="form-label fw-bold d-block text-start mb-2">Xem trước hình ảnh</label>
                        <img id="imagePreview" src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800" class="rounded-3 shadow-sm mb-3" style="max-height: 200px; width: 100%; object-fit: cover;" alt="Preview" />

                        <label asp-for="ImageUrl" class="form-label fw-semibold d-block text-start">Đường dẫn URL hình ảnh:</label>
                        <input asp-for="ImageUrl" class="form-control rounded-3" id="imageUrlInput" oninput="updatePreviewImage()" placeholder="https://images.unsplash.com/..." required />
                        <span asp-validation-for="ImageUrl" class="text-danger small d-block text-start"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tiêu đề bài đăng</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="Ví dụ: Phòng trọ gác lửng Q.Bình Thạnh..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-semibold">Giá thuê (VNĐ/tháng)</label>
                            <input asp-for="Price" type="number" class="form-control rounded-3" placeholder="3000000" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Area" class="form-label fw-semibold">Diện tích (m²)</label>
                            <input asp-for="Area" type="number" step="0.1" class="form-control rounded-3" placeholder="25" required />
                            <span asp-validation-for="Area" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="District" class="form-label fw-semibold">Quận / Huyện</label>
                            @if (User.IsInRole("ChuTro") && !string.IsNullOrEmpty(ViewBag.UserDistrict as string))
                            {
                                <input asp-for="District" class="form-control rounded-3" value="@ViewBag.UserDistrict" readonly />
                                <small class="text-muted">* Tự động khóa theo Quận bạn quản lý</small>
                            }
                            else
                            {
                                <select asp-for="District" class="form-select rounded-3" required>
                                    <option value="">-- Chọn Quận / Huyện --</option>
                                    <!-- Các Quận nội thành -->
                                    <option value="Quận 1">Quận 1</option>
                                    <option value="Quận 3">Quận 3</option>
                                    <option value="Quận 4">Quận 4</option>
                                    <option value="Quận 5">Quận 5</option>
                                    <option value="Quận 6">Quận 6</option>
                                    <option value="Quận 7">Quận 7</option>
                                    <option value="Quận 8">Quận 8</option>
                                    <option value="Quận 10">Quận 10</option>
                                    <option value="Quận 11">Quận 11</option>
                                    <option value="Quận 12">Quận 12</option>

                                    <!-- Các Quận tên riêng -->
                                    <option value="Bình Thạnh">Bình Thạnh</option>
                                    <option value="Gò Vấp">Gò Vấp</option>
                                    <option value="Phú Nhuận">Phú Nhuận</option>
                                    <option value="Tân Bình">Tân Bình</option>
                                    <option value="Tân Phú">Tân Phú</option>
                                    <option value="Bình Tân">Bình Tân</option>
                                    <option value="TP. Thủ Đức">TP. Thủ Đức</option>

                                    <!-- Các Huyện ngoại thành -->
                                    <option value="Bình Chánh">Huyện Bình Chánh</option>
                                    <option value="Hóc Môn">Huyện Hóc Môn</option>
                                    <option value="Nhà Bè">Huyện Nhà Bè</option>
                                    <option value="Củ Chi">Huyện Củ Chi</option>
                                    <option value="Cần Giờ">Huyện Cần Giờ</option>
                                </select>
                            }
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Loại hình phòng</label>
                            <select asp-for="CategoryId" class="form-select rounded-3" asp-items="ViewBag.CategoryId" required></select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ chi tiết</label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="Ví dụ: 123 Nguyễn Gia Trí, Phường 25" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 d-flex gap-4">
                        <div class="form-check">
                            <input asp-for="IsOwner" class="form-check-input" type="checkbox" id="isOwnerCheck" checked />
                            <label class="form-check-label fw-semibold" for="isOwnerCheck">Chính chủ</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="HasMezzanine" class="form-check-input" type="checkbox" id="hasMezzanineCheck" />
                            <label class="form-check-label fw-semibold" for="hasMezzanineCheck">Có gác lửng</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-teal text-white rounded-pill px-4 fw-bold" style="background-color: #0d7a75;">Tạo phòng mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function updatePreviewImage() {
        const url = document.getElementById('imageUrlInput').value;
        const preview = document.getElementById('imagePreview');
        if (url) {
            preview.src = url;
        }
    }
</script>