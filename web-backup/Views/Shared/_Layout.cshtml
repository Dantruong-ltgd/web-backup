@using Microsoft.AspNetCore.Identity
@using web_backup.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PT-SG | Tìm Phòng Trọ & Chung Cư HCMC</title>

    <!-- Bootstrap CSS mặc định -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CDN Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --primary-teal: #0d7a75;
                --hover-teal: #095955;
            }

            .bg-teal {
                background-color: var(--primary-teal) !important;
            }

            .text-teal {
                color: var(--primary-teal) !important;
            }

            .btn-teal {
                background-color: var(--primary-teal);
                color: #ffffff;
                border: none;
            }

            .btn-teal:hover {
                background-color: var(--hover-teal);
                color: #ffffff;
            }

            .btn-outline-teal {
                border: 1px solid var(--primary-teal);
                color: var(--primary-teal);
            }

            .btn-outline-teal:hover {
                background-color: var(--primary-teal);
                color: #ffffff;
            }

            .nav-link-custom {
                color: #333333;
                font-weight: 500;
                transition: color 0.2s ease;
            }

            .nav-link-custom:hover {
                color: var(--primary-teal);
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- HEADER / NAVIGATION BAR -->
    <header class="border-bottom bg-white sticky-top shadow-sm">
        <div class="container d-flex justify-content-between align-items-center py-2">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center fw-bold text-teal fs-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door-fill me-2"></i>PT-SG
            </a>

            <!-- Menu trên màn hình lớn -->
            <!-- Menu trên màn hình lớn -->
            <!-- Menu trên màn hình lớn -->
            <nav class="d-none d-md-flex gap-4 fw-semibold">
                <a href="/" class="text-decoration-none nav-link-custom text-teal">Trang chủ</a>
                <a href="/Home/BoardingHouse" class="text-decoration-none nav-link-custom text-dark">Phòng trọ</a>
                <a href="/Home/Apartment" class="text-decoration-none nav-link-custom text-dark">Chung cư</a>
                <a href="/Home/House" class="text-decoration-none nav-link-custom text-dark">Nhà nguyên căn</a>
                <a href="/Home/SharedRoom" class="text-decoration-none nav-link-custom text-dark">Ở ghép</a>
            </nav>

            <!-- Nút Đăng nhập -->
            <div class="d-flex align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <div class="dropdown">
                        <button class="btn btn-outline-teal dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i> Chào, <strong>@(currentUser?.FullName ?? User.Identity?.Name)</strong>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                            <!-- 1. Dòng Thông tin cá nhân mới thêm -->
                            <li>
                                <a class="dropdown-item px-3 py-2" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-badge me-2 text-primary"></i>Thông tin cá nhân
                                </a>
                            </li>

                            <!-- 2. Quản lý phòng (Dành cho Admin và Chủ trọ) -->
                            @if (User.IsInRole("Admin") || User.IsInRole("ChuTro"))
                            {
                                <li>
                                    <a class="dropdown-item px-3 py-2" asp-controller="RoomManager" asp-action="Index">
                                        <i class="bi bi-house-gear me-2 text-teal"></i>Quản lý phòng
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>

                            <!-- 3. Nút Đăng xuất -->
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger px-3 py-2">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-teal rounded-pill px-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-teal text-white rounded-pill px-3" style="background-color: #0d9488;">
                        Đăng Ký
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH (Giao diện từng trang sẽ chèn vào đây) -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="bg-teal text-white mt-auto pt-4 pb-3">
        <div class="container">
            <div class="row gy-4">
                <div class="col-12 col-md-3">
                    <h5 class="fw-bold mb-3">Về Chúng Tôi</h5>
                    <p class="small text-white-50">
                        Kênh thông tin tìm kiếm phòng trọ, chung cư mini, nhà nguyên căn uy tín hàng đầu tại TP. Hồ Chí Minh.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h5 class="fw-bold mb-3">Hỗ Trợ Khách Hàng</h5>
                    <ul class="list-unstyled small text-white-50 lh-lg">
                        <li><a href="#" class="text-white-50 text-decoration-none">Trung tâm trợ giúp</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Quy định đăng tin</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Bảng giá dịch vụ</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h5 class="fw-bold mb-3">Điều Khoản</h5>
                    <ul class="list-unstyled small text-white-50 lh-lg">
                        <li><a href="#" class="text-white-50 text-decoration-none">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Giải quyết tranh chấp</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3">
                    <h5 class="fw-bold mb-3">Đối Tác & Mạng Xã Hội</h5>
                    <div class="d-flex gap-3 fs-4 mb-2">
                        <a href="#" class="text-white"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-3 border-light opacity-25" />
            <div class="text-center small text-white-50">
                &copy; @DateTime.Now.Year - PT-SG. Tất cả quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <!-- Các file JavaScript mặc định -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <style>
            .room-card {
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .room-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
                }
    </style>

    <script>
            function toggleFavorite(btn, event) {
                event.stopPropagation(); // Ngăn không bị nhảy sang trang chi tiết khi bấm tim
                const icon = btn.querySelector('i');
                if (icon.classList.contains('bi-heart')) {
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill');
                } else {
                    icon.classList.remove('bi-heart-fill');
                    icon.classList.add('bi-heart');
                }
            }
    </script>
</body>
</html>