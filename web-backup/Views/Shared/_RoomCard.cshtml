@model web_backup.Models.Room

<div class="col-md-4 mb-4">
    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden room-card position-relative">
        <!-- Ảnh phòng -->
        <div class="position-relative">
            <img src="@Model.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@Model.Title">

            <!-- Nút Thả tim (Yêu thích) -->
            <button type="button"
                    class="btn btn-sm btn-light rounded-circle position-absolute top-0 end-0 m-2 shadow-sm z-3"
                    onclick="toggleFavorite(this, event)">
                <i class="bi bi-heart text-danger"></i>
            </button>
        </div>

        <!-- Thông tin phòng -->
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <h6 class="fw-bold mb-0 text-truncate" style="max-width: 70%;">
                    <!-- Thẻ <a> điều hướng sang trang Chi tiết -->
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none stretched-link">
                        @Model.Title
                    </a>
                </h6>
                <span class="badge bg-light text-dark border">@Model.Area m²</span>
            </div>

            <p class="text-teal fw-bold mb-1">@Model.Price.ToString("N0") VNĐ/tháng</p>
            <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @Model.Address</p>

            <div class="d-flex justify-content-between align-items-center position-relative z-2">
                <div>
                    @if (Model.IsOwner)
                    {
                        <span class="badge bg-light text-secondary border">Chính chủ</span>
                    }
                    @if (Model.HasMezzanine)
                    {
                        <span class="badge bg-light text-secondary border">Gác lửng</span>
                    }
                </div>
                <div class="text-muted small gap-1 d-flex">
                    <i class="bi bi-snow" title="Máy lạnh"></i>
                    <i class="bi bi-wifi" title="Wifi"></i>
                    <i class="bi bi-box-seam" title="Nội thất"></i>
                </div>
            </div>
        </div>
    </div>
</div>